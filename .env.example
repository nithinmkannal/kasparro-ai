# .env.example  –  copy to .env and fill in your values
# NEVER commit the real .env file

# OpenAI (required for --provider openai)
OPENAI_API_KEY=sk-...

# Groq (required for --provider groq  –  free at https://console.groq.com)
GROQ_API_KEY=gsk_...

# Gemini (required for --provider gemini  –  free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIzaSy...

# Langfuse (optional – tracing disabled if unset)
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/kasparro

# FastAPI
API_BASE=http://localhost:8000
